[physics]

; Le vol et la logique de jeu tournent en _physics_process à pas fixe (PLAN_GODOT.md §5.5).
; 60 Hz est aussi la valeur par défaut de Godot : explicite ici pour qu'une future
; montée de version ne change pas silencieusement la dynamique du vol.
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
