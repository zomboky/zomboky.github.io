[Unit]
Description=Serveur WebSocket multijoueur pour le jeu d'echecs (zomboky.github.io)
After=network.target

[Service]
Type=simple
User=chessd
Group=chessd
WorkingDirectory=/opt/chess-server
ExecStart=/usr/bin/node /opt/chess-server/server.js
Environment=CHESS_SERVER_HOST=127.0.0.1
Environment=CHESS_SERVER_PORT=8095
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chess-server

[Install]
WantedBy=multi-user.target
