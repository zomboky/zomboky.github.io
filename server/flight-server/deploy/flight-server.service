[Unit]
Description=API de sauvegarde/partage des avions du simulateur de vol (zomboky.github.io)
After=network.target

[Service]
Type=simple
User=flightd
Group=flightd
WorkingDirectory=/opt/flight-server
ExecStart=/usr/bin/node /opt/flight-server/server.js
Environment=FLIGHT_SERVER_HOST=127.0.0.1
Environment=FLIGHT_SERVER_PORT=8097
Environment=FLIGHT_DESIGNS_DIR=/var/lib/flight-server/designs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/flight-server /var/lib/flight-server

[Install]
WantedBy=multi-user.target
