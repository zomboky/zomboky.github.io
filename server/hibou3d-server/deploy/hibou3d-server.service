[Unit]
Description=Serveur WebSocket multijoueur pour Hibou 3D (zomboky.github.io)
After=network.target

[Service]
Type=simple
User=hibou3dd
Group=hibou3dd
WorkingDirectory=/opt/hibou3d-server
ExecStart=/usr/bin/node /opt/hibou3d-server/server.js
Environment=HIBOU3D_SERVER_HOST=127.0.0.1
Environment=HIBOU3D_SERVER_PORT=8098
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hibou3d-server

[Install]
WantedBy=multi-user.target
