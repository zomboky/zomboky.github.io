[Unit]
Description=API de monitoring des maladies des orangers (zomboky.github.io)
After=network.target

[Service]
Type=simple
User=oranged
Group=oranged
WorkingDirectory=/opt/orange-server
ExecStart=/usr/bin/node /opt/orange-server/server.js
Environment=ORANGE_SERVER_HOST=127.0.0.1
Environment=ORANGE_SERVER_PORT=8096
Environment=GEE_KEY_PATH=/opt/orange-server/gee-key.json
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/orange-server

[Install]
WantedBy=multi-user.target
