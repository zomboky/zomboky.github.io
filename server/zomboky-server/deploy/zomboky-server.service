[Unit]
Description=API générale du site zomboky.github.io (compteur, verrou Hibou 3D, admin)
After=network.target

[Service]
Type=simple
User=zombokyd
Group=zombokyd
WorkingDirectory=/opt/zomboky-server
ExecStart=/usr/bin/node /opt/zomboky-server/server.js
Environment=ZOMBOKY_SERVER_HOST=127.0.0.1
Environment=ZOMBOKY_SERVER_PORT=8096
Environment=VISITOR_COUNT_FILE=/var/lib/zomboky-server/visitor-count.json
EnvironmentFile=-/opt/zomboky-server/zomboky-passwords.env
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zomboky-server /var/lib/zomboky-server

[Install]
WantedBy=multi-user.target
